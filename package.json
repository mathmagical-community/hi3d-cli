{
  "name": "hi3d-cli-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "hi3d-cli \u2014 Hi3D image-to-3D CLI and MCP server for terminals and AI agents",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/mcp packages/cli",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo release",
    "test": "bash test/run-e2e.sh",
    "release": "node scripts/build-release.mjs",
    "release:pack": "npm run release && cd release && npm pack ./hi3d-cli"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}